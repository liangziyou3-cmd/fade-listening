# Choose one provider in the browser by setting TTS_PROVIDER=qwen or doubao.
TTS_PROVIDER=qwen

# Qwen / DashScope
DASHSCOPE_API_KEY=
QWEN_TTS_MODEL=qwen-audio-3.1-tts-flash
QWEN_TTS_VOICE=Cherry
# QWEN_TTS_ENDPOINT=https://dashscope.aliyuncs.com/api/v1/services/audio/tts/generation

# Doubao / Volcano Engine Speech
DOUBAO_APP_ID=
DOUBAO_ACCESS_TOKEN=
DOUBAO_CLUSTER=volcano_tts
DOUBAO_VOICE=zh_female_qingxin
# DOUBAO_TTS_ENDPOINT=https://openspeech.bytedance.com/api/v1/tts
